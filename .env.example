# PlacementWire Environment Configuration
# Copy this file to `.env` and fill EVERY value with your own secrets.
# The app refuses to boot if any required variable is missing — there are
# intentionally no fallback defaults for secrets, emails or URLs in code.
# Never commit `.env`. Never paste real secrets into code or this file.

# App Settings (single Next.js endpoint — frontend + API on the same port)
ENVIRONMENT=development
APP_URL=http://localhost:8000
SESSION_SECRET=paste-a-random-string-at-least-32-chars-long-here

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=paste-your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Security & Domain Restrictions
ALLOWED_EMAIL_DOMAIN=saitm.ac.in

# Admin allowlist (comma-separated). Only these Google accounts see the Admin Panel.
ADMIN_EMAILS=admin1@saitm.ac.in,admin2@saitm.ac.in

# Development Mock Auth (Set to true to test UI & mock sync without a college Google account)
DEV_MOCK_AUTH=false

# Contact Form relay (Contact Us page submissions are forwarded here;
# the API key stays server-side and is never exposed to the browser)
CONTACT_FORM_API_URL=https://your-relay-host/api/forms/placement-wire/submit
CONTACT_FORM_API_KEY=paste-your-contact-form-api-key
