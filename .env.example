# PlacementWire Environment Configuration

# App Settings (single Next.js endpoint — frontend + API on the same port)
ENVIRONMENT=development
APP_URL=http://localhost:8000
SESSION_SECRET=generate-a-secure-random-string-at-least-32-chars

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Security & Domain Restrictions
ALLOWED_EMAIL_DOMAIN=saitm.ac.in

# Development Mock Auth (Set to true to test UI & mock sync without @saitm.ac.in Google account)
DEV_MOCK_AUTH=false

# Contact Form relay (Contact Us page submissions are forwarded here;
# the API key stays server-side and is never exposed to the browser)
CONTACT_FORM_API_URL=https://my-manager-eight.vercel.app/api/forms/placement-wire/submit
CONTACT_FORM_API_KEY=your-contact-form-api-key

